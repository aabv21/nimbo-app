{
  "name": "nimbo-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
    "@expo-google-fonts/literata": "^0.4.3",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.22",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.6",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.15",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.70.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.1",
    "expo-doctor": "^1.21.6",
    "jest": "~30.5.2",
    "jest-expo": "58.0.13",
    "jiti": "^2.7.0",
    "supabase": "2.122.1",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "routes:types": "expo customize tsconfig.json < /dev/null",
    "pretypecheck": "pnpm run routes:types",
    "typecheck": "tsc --noEmit",
    "prelint": "pnpm run routes:types",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects app scripts functions",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --selectProjects integration --runInBand",
    "check:expo": "expo install --check",
    "check:supply-chain": "node scripts/check-supply-chain.ts",
    "db:start": "supabase start",
    "db:start:ci": "supabase start -x studio,realtime,vector,logflare,imgproxy",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "env:local": "node scripts/env-local.ts",
    "catalog:sql": "node scripts/catalog-sql.ts",
    "premium": "node scripts/premium.ts",
    "calibrate": "node scripts/calibrate.ts",
    "e2e": "node scripts/e2e.ts",
    "policy:check": "node scripts/policy-check.ts"
  }
}
