{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Nimbo Data Model",
    "locale": "en",
    "output": "docs/diagrams/data-model.html",
    "quality_profile": "showcase"
  },
  "layout": {
    "mode": "grid",
    "cols": 5,
    "cellW": 170,
    "cellH": 64,
    "gapX": 70,
    "gapY": 60,
    "origin": [
      40,
      80
    ]
  },
  "components": [
    {
      "id": "users",
      "type": "database",
      "label": "auth.users",
      "sublabel": "Supabase Auth",
      "row": 0,
      "col": 0
    },
    {
      "id": "trig",
      "type": "backend",
      "label": "handle_new_user()",
      "sublabel": "after insert trigger",
      "row": 0,
      "col": 1
    },
    {
      "id": "profiles",
      "type": "database",
      "label": "public.profiles",
      "sublabel": "settings and consent",
      "row": 0,
      "col": 2,
      "tag": "RLS"
    },
    {
      "id": "profileRpcs",
      "type": "security",
      "label": "Profile RPCs",
      "sublabel": "terms, AI, onboarding",
      "row": 0,
      "col": 3
    },
    {
      "id": "entitlements",
      "type": "database",
      "label": "public.entitlements",
      "sublabel": "grant and purchase",
      "row": 0,
      "col": 4,
      "tag": "RLS"
    },
    {
      "id": "checkins",
      "type": "database",
      "label": "public.checkins",
      "sublabel": "one per local date",
      "row": 1,
      "col": 0,
      "tag": "RLS"
    },
    {
      "id": "trackingRpcs",
      "type": "security",
      "label": "Tracking RPCs",
      "sublabel": "9, set_dose_helped too",
      "row": 1,
      "col": 1
    },
    {
      "id": "app",
      "type": "frontend",
      "label": "Nimbo app",
      "sublabel": "role authenticated",
      "row": 1,
      "col": 2
    },
    {
      "id": "premium",
      "type": "security",
      "label": "has_premium()",
      "sublabel": "own row only",
      "row": 1,
      "col": 3
    },
    {
      "id": "episodes",
      "type": "database",
      "label": "public.episodes",
      "sublabel": "attacks, debrief",
      "row": 2,
      "col": 0,
      "tag": "RLS"
    },
    {
      "id": "doses",
      "type": "database",
      "label": "public.doses",
      "sublabel": "optional episode",
      "row": 2,
      "col": 1,
      "tag": "RLS"
    },
    {
      "id": "medications",
      "type": "database",
      "label": "public.medications",
      "sublabel": "acute and preventive",
      "row": 2,
      "col": 2,
      "tag": "RLS"
    },
    {
      "id": "noteRpcs",
      "type": "security",
      "label": "Note RPCs",
      "sublabel": "save_ / delete_agent_note",
      "row": 2,
      "col": 3,
      "size": [
        160,
        64
      ]
    },
    {
      "id": "agentNotes",
      "type": "database",
      "label": "public.agent_notes",
      "sublabel": "20 per user",
      "row": 2,
      "col": 4,
      "tag": "RLS"
    },
    {
      "id": "companion",
      "type": "backend",
      "label": "companion",
      "sublabel": "Edge Function",
      "row": 3,
      "col": 2
    },
    {
      "id": "consumeQuota",
      "type": "security",
      "label": "consume_quota()",
      "sublabel": "service role only",
      "row": 3,
      "col": 3
    },
    {
      "id": "usage",
      "type": "database",
      "label": "usage_counters",
      "sublabel": "public, no grants",
      "row": 3,
      "col": 4,
      "tag": "RLS"
    }
  ],
  "connections": [
    {
      "id": "users-trig",
      "from": "users",
      "to": "trig",
      "label": "new user"
    },
    {
      "id": "trig-profiles",
      "from": "trig",
      "to": "profiles",
      "label": "inserts row",
      "variant": "emphasis"
    },
    {
      "id": "app-profiles",
      "from": "app",
      "to": "profiles",
      "label": "update 13 columns",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "app-profileRpcs",
      "from": "app",
      "to": "profileRpcs"
    },
    {
      "id": "profileRpcs-profiles",
      "from": "profileRpcs",
      "to": "profiles",
      "label": "server time",
      "variant": "security"
    },
    {
      "id": "app-premium",
      "from": "app",
      "to": "premium"
    },
    {
      "id": "premium-entitlements",
      "from": "premium",
      "to": "entitlements",
      "label": "reads",
      "fromSide": "right",
      "toSide": "bottom"
    },
    {
      "id": "app-trackingRpcs",
      "from": "app",
      "to": "trackingRpcs",
      "label": "outbox",
      "variant": "emphasis"
    },
    {
      "id": "rpcs-checkins",
      "from": "trackingRpcs",
      "to": "checkins",
      "variant": "security"
    },
    {
      "id": "rpcs-episodes",
      "from": "trackingRpcs",
      "to": "episodes",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "rpcs-doses",
      "from": "trackingRpcs",
      "to": "doses",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "rpcs-medications",
      "from": "trackingRpcs",
      "to": "medications",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "doses-episodes",
      "from": "doses",
      "to": "episodes",
      "label": "set null",
      "variant": "dashed"
    },
    {
      "id": "doses-medications",
      "from": "doses",
      "to": "medications",
      "label": "references"
    },
    {
      "id": "app-noteRpcs",
      "from": "app",
      "to": "noteRpcs",
      "fromSide": "right",
      "toSide": "top"
    },
    {
      "id": "noteRpcs-agentNotes",
      "from": "noteRpcs",
      "to": "agentNotes",
      "variant": "security"
    },
    {
      "id": "companion-consumeQuota",
      "from": "companion",
      "to": "consumeQuota",
      "label": "per message",
      "variant": "emphasis"
    },
    {
      "id": "consumeQuota-usage",
      "from": "consumeQuota",
      "to": "usage",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Ownership",
      "items": [
        "Every table keys rows to auth.users, deleted with the user",
        "Each has a read-own select policy, except usage_counters, which has none"
      ]
    },
    {
      "dot": "rose",
      "title": "RPC-only writes",
      "items": [
        "Health rows, consent and onboarding are written only by security definer RPCs",
        "Notes go through save_agent_note and delete_agent_note; a direct write fails with 42501"
      ]
    },
    {
      "dot": "cyan",
      "title": "Debrief",
      "items": [
        "episodes.helped, did_not_help and debriefed_at; doses.helped",
        "update_episode stamps debriefed_at; set_dose_helped sets a dose's helped"
      ]
    },
    {
      "dot": "amber",
      "title": "Quotas and premium",
      "items": [
        "consume_quota counts per user, local day and kind: 40 companion, 20 dictation, 200 screen",
        "Only the service role or the dashboard writes entitlements"
      ]
    }
  ]
}
