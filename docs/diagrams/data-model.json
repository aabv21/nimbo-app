{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Nimbo Data Model",
    "locale": "en",
    "output": "docs/diagrams/data-model.html",
    "quality_profile": "showcase"
  },
  "layout": {
    "mode": "grid",
    "cols": 5,
    "cellW": 170,
    "cellH": 64,
    "gapX": 70,
    "gapY": 84,
    "origin": [
      40,
      80
    ]
  },
  "components": [
    {
      "id": "users",
      "type": "database",
      "label": "auth.users",
      "sublabel": "Supabase Auth",
      "row": 0,
      "col": 0
    },
    {
      "id": "trig",
      "type": "backend",
      "label": "handle_new_user()",
      "sublabel": "after insert trigger",
      "row": 0,
      "col": 1
    },
    {
      "id": "profiles",
      "type": "database",
      "label": "public.profiles",
      "sublabel": "settings and consent",
      "row": 0,
      "col": 2,
      "tag": "RLS"
    },
    {
      "id": "profileRpcs",
      "type": "security",
      "label": "Profile RPCs",
      "sublabel": "terms, AI, onboarding",
      "row": 0,
      "col": 3
    },
    {
      "id": "entitlements",
      "type": "database",
      "label": "public.entitlements",
      "sublabel": "grant and purchase",
      "row": 0,
      "col": 4,
      "tag": "RLS"
    },
    {
      "id": "checkins",
      "type": "database",
      "label": "public.checkins",
      "sublabel": "one per local date",
      "row": 1,
      "col": 0,
      "tag": "RLS"
    },
    {
      "id": "trackingRpcs",
      "type": "security",
      "label": "Tracking RPCs",
      "sublabel": "log_episode + 7 more",
      "row": 1,
      "col": 1
    },
    {
      "id": "app",
      "type": "frontend",
      "label": "Nimbo app",
      "sublabel": "role authenticated",
      "row": 1,
      "col": 2
    },
    {
      "id": "premium",
      "type": "security",
      "label": "has_premium()",
      "sublabel": "own row only",
      "row": 1,
      "col": 4
    },
    {
      "id": "episodes",
      "type": "database",
      "label": "public.episodes",
      "sublabel": "attacks",
      "row": 2,
      "col": 0,
      "tag": "RLS"
    },
    {
      "id": "doses",
      "type": "database",
      "label": "public.doses",
      "sublabel": "optional episode",
      "row": 2,
      "col": 1,
      "tag": "RLS"
    },
    {
      "id": "medications",
      "type": "database",
      "label": "public.medications",
      "sublabel": "acute and preventive",
      "row": 2,
      "col": 2,
      "tag": "RLS"
    }
  ],
  "connections": [
    {
      "id": "users-trig",
      "from": "users",
      "to": "trig",
      "label": "new user"
    },
    {
      "id": "trig-profiles",
      "from": "trig",
      "to": "profiles",
      "label": "inserts row",
      "variant": "emphasis"
    },
    {
      "id": "app-profiles",
      "from": "app",
      "to": "profiles",
      "label": "update 13 columns",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "app-profileRpcs",
      "from": "app",
      "to": "profileRpcs"
    },
    {
      "id": "profileRpcs-profiles",
      "from": "profileRpcs",
      "to": "profiles",
      "label": "server time",
      "variant": "security"
    },
    {
      "id": "app-premium",
      "from": "app",
      "to": "premium"
    },
    {
      "id": "premium-entitlements",
      "from": "premium",
      "to": "entitlements",
      "label": "reads"
    },
    {
      "id": "app-trackingRpcs",
      "from": "app",
      "to": "trackingRpcs",
      "label": "outbox",
      "variant": "emphasis"
    },
    {
      "id": "rpcs-checkins",
      "from": "trackingRpcs",
      "to": "checkins",
      "variant": "security"
    },
    {
      "id": "rpcs-episodes",
      "from": "trackingRpcs",
      "to": "episodes",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "rpcs-doses",
      "from": "trackingRpcs",
      "to": "doses",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "rpcs-medications",
      "from": "trackingRpcs",
      "to": "medications",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "doses-episodes",
      "from": "doses",
      "to": "episodes",
      "label": "set null",
      "variant": "dashed"
    },
    {
      "id": "doses-medications",
      "from": "doses",
      "to": "medications",
      "label": "references"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Ownership",
      "items": [
        "Every table keys rows to auth.users, deleted with the user",
        "Each has one read-own select policy for authenticated"
      ]
    },
    {
      "dot": "rose",
      "title": "RPC-only writes",
      "items": [
        "Consent, onboarding and every health row are written only by security definer RPCs",
        "A direct insert, update or delete fails with 42501"
      ]
    },
    {
      "dot": "cyan",
      "title": "Profile",
      "items": [
        "Location is a coarse area: coarse_lat and coarse_lon at one decimal",
        "priority is one of four, known_triggers are catalog keys, track_period is opt-in"
      ]
    },
    {
      "dot": "amber",
      "title": "Premium",
      "items": [
        "Only the service role or the dashboard writes entitlements",
        "A grant and a purchase never cancel each other"
      ]
    }
  ]
}
