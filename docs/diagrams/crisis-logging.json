  "cards": [
    {
      "dot": "emerald",
      "title": "Saved before the push",
      "items": [
        "The row and its RPC call commit in one SQLite transaction",
        "A kill after the tap loses nothing"
      ]
    },
    {
      "dot": "amber",
      "title": "Sent once",
      "items": [
        "The id is made on the phone, so a replay hits on conflict do nothing",
        "No answer gives the attempt back; time offline never fails an op"
      ]
    },
    {
      "dot": "rose",
      "title": "Pull never undoes",
      "items": [
        "Dirty rows and rows with an unsent op are skipped",
        "Only the signed-in user's rows are read or written"
      ]
    }
