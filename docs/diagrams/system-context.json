  "cards": [
    {
      "dot": "emerald",
      "title": "Today",
      "items": [
        "The phone saves to nimbo.db first and queues each write",
        "RLS and column grants scope every row; health writes go through RPCs",
        "Consent is written only by two RPCs"
      ]
    },
    {
      "dot": "amber",
      "title": "Planned",
      "items": [
        "Dashed boxes and lines arrive in later waves",
        "Model calls will run only in Edge Functions"
