  "cards": [
    {
      "dot": "emerald",
      "title": "On the phone",
      "items": [
        "Health data is saved to nimbo.db first and each write is queued",
        "The chat is kept only on this phone"
      ]
    },
    {
      "dot": "cyan",
      "title": "The companion",
      "items": [
        "Model calls run only in the companion function",
        "Requests carry no name, email, id or location"
      ]
    },
    {
      "dot": "amber",
      "title": "Planned",
      "items": [
        "The boxes marked planned and the dashed lines arrive in later waves",
        "Weather and other data APIs come with insights"
      ]
    },
    {
      "dot": "rose",
      "title": "Keys",
      "items": [
        "The app holds the URL and the anon key",
        "Provider keys are function secrets, never in src/"
      ]
    }
  ]
}
