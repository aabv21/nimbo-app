{
  "expo": {
    "name": "Nimbo",
    "slug": "nimbo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nimbo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aabv21.nimbo",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.aabv21.nimbo",
      "adaptiveIcon": {
        "backgroundColor": "#5f7a70",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f6f1ea",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      ["expo-localization", { "supportedLocales": ["en", "es", "pt"] }],
      "expo-sqlite",
      "expo-apple-authentication",
      ["expo-notifications", { "defaultChannel": "preventive-reminders", "enableRemoteNotifications": false }],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nimbo uses your approximate area, never your exact location, to show weather changes that can set off an attack.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosReducedAccuracyByDefault": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Nimbo uses the microphone only while you hold the mic, to dictate a message to Nimbo or tell it about an attack.",
          "speechRecognitionPermission": "Nimbo turns what you dictate into text, on this phone, so you can send it to Nimbo or save it in an attack's notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
